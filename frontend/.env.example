# URL de la API en Go. Si se omite o la API no responde, el frontend usa la simulación local (localStorage).
NEXT_PUBLIC_API_URL=http://localhost:8080

# reCAPTCHA v3 (invisible): clave PÚBLICA del sitio. Se crea en https://www.google.com/recaptcha/admin (tipo "v3").
# La clave SECRETA va en el backend (variable RECAPTCHA_SECRET de docker-compose), nunca aquí.
# Si se deja vacía, el login funciona sin reCAPTCHA (sólo campo trampa + tiempo mínimo).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
